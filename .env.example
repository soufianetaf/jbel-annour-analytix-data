# ════════════════════════════════════════════════════════════════
#  Jbel Annour Analytix : variables d'environnement
# ════════════════════════════════════════════════════════════════
#  Mode d'emploi :
#    1. copy .env.example .env
#    2. remplir .env avec vos accès (demandés à l'équipe informatique)
#  Le fichier .env n'est JAMAIS versionné. Ce modèle ne contient
#  aucune valeur réelle : ni mot de passe, ni adresse de serveur.
# ════════════════════════════════════════════════════════════════

# ─── Environnement ───────────────────────────────────────────────
# dev  : poste du développeur, base dw_dev
# prod : serveur de l'entreprise, base dw_prod
ANALYTIX_ENV=dev

# ─── Sources (SQL Server, comptes en LECTURE SEULE uniquement) ───
# Ne jamais utiliser le compte « sa ».
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Réseau interne sans certificat public : à confirmer avec l'informatique
SQLSERVER_TRUST_CERT=yes

# Sage X3 : dossier BASE1 (gestion de Jbel Annour)
X3_HOST=
X3_INSTANCE=
X3_DATABASE=
X3_SCHEMA=BASE1
X3_USER=
X3_PASSWORD=

# Sage X3 : dossier du groupe (JBELRH) — données RH sensibles
JBELRH_HOST=
JBELRH_DATABASE=JBELRH
JBELRH_USER=
JBELRH_PASSWORD=

# Serveur de l'usine (applications internes, machines)
USINE_HOST=
USINE_USER=
USINE_PASSWORD=

# ─── Data warehouse (PostgreSQL 16) ──────────────────────────────
DW_HOST=localhost
DW_PORT=5432
DW_DATABASE=dw_dev
# Compte qui charge et transforme les données (ingestion + dbt)
DW_USER=
DW_PASSWORD=

# ─── API (FastAPI) ───────────────────────────────────────────────
# Compte PostgreSQL de l'API : lecture seule sur le schéma marts
API_DB_USER=
API_DB_PASSWORD=
# Clé de signature des jetons de connexion (longue chaîne aléatoire)
API_SECRET_KEY=
# Adresse(s) de l'interface web autorisée(s) à appeler l'API (CORS)
API_CORS_ORIGINS=http://localhost:5173
