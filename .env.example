# ════════════════════════════════════════════════════════════════
#  Jbel Annour Analytix : variables d'environnement
# ════════════════════════════════════════════════════════════════
#  Mode d'emploi :
#    1. copy .env.example .env
#    2. remplir .env avec vos accès (demandés à l'équipe informatique)
#    3. uv run python -m ingestion.verifier_connexions
#  Le fichier .env n'est JAMAIS versionné. Ce modèle ne contient
#  aucune valeur réelle : ni mot de passe, ni adresse de serveur.
# ════════════════════════════════════════════════════════════════

# ─── Environnement ───────────────────────────────────────────────
# dev  : poste du développeur, base dw_dev
# prod : serveur de l'entreprise, base dw_prod
ANALYTIX_ENV=dev

# ─── Sources SQL Server : paramètres communs ─────────────────────
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# yes uniquement si le serveur interne utilise un certificat auto-signé
SQLSERVER_TRUST_CERT=no

# ─── Sources : UN compte en LECTURE SEULE par serveur ────────────
# Jamais le compte « sa ». Le compte ne doit avoir que db_datareader :
# ingestion.verifier_connexions refuse tout compte qui peut écrire.
#
# <SOURCE>_HOST     serveur, ou serveur\INSTANCE
# <SOURCE>_PORT     facultatif (1433 par défaut ; vide avec une instance nommée)
# <SOURCE>_DATABASE base par défaut
# <SOURCE>_AUTH     sql (compte + mot de passe) ou windows (compte du poste)
# <SOURCE>_USER / <SOURCE>_PASSWORD : seulement si AUTH=sql

# Sage X3 : gestion de Jbel Annour
X3_HOST=
X3_PORT=
X3_DATABASE=
# Dossier X3 utilisé (schéma SQL) : seul BASE1 est le dossier réel
X3_DOSSIER=BASE1
X3_AUTH=sql
X3_USER=
X3_PASSWORD=

# Sage X3 : dossier du groupe (JBELRH) — données RH sensibles
JBELRH_HOST=
JBELRH_PORT=
JBELRH_DATABASE=
JBELRH_AUTH=sql
JBELRH_USER=
JBELRH_PASSWORD=

# Serveur de l'usine : une quarantaine de bases sur le même serveur
# (moulage, production_2026, maintenance_2026, espace_magasin…).
# La base est choisie par l'ingestion ; DATABASE peut rester vide.
USINE_HOST=
USINE_PORT=
USINE_DATABASE=
USINE_AUTH=sql
USINE_USER=
USINE_PASSWORD=

# ─── Dérogation : compte qui peut écrire ─────────────────────────
# Par défaut, un compte qui a des droits d'écriture est refusé.
# <SOURCE>_COMPTE_ADMIN_ACCEPTE=yes l'accepte (dev et prod), avec un
# avertissement à chaque exécution. Décision de l'entreprise : le serveur
# de l'usine est lu avec le compte « sa ». La lecture seule n'est alors
# plus garantie par le serveur : seul le code d'Analytix, qui n'exécute
# que des lectures, protège la source.
USINE_COMPTE_ADMIN_ACCEPTE=no

# ─── Data warehouse (PostgreSQL 16) ──────────────────────────────
DW_HOST=localhost
DW_PORT=5432
# dw_dev (poste), dw_prod (serveur) ; dw_test est réservé aux tests
DW_DATABASE=dw_dev

# Compte administrateur PostgreSQL : utilisé SEULEMENT par
# infra.postgres.initialiser_entrepot, pour créer rôles, base et schémas.
DW_ADMIN_USER=postgres
DW_ADMIN_PASSWORD=

# Compte qui charge et transforme les données (ingestion + dbt).
# Créé par le script d'initialisation ; le nom doit commencer par analytix_
DW_USER=analytix_chargeur
DW_PASSWORD=

# ─── API (FastAPI) ───────────────────────────────────────────────
# Compte PostgreSQL de l'API : lecture seule sur le schéma marts,
# forcée par le serveur. Créé par le script d'initialisation.
API_DB_USER=analytix_api
API_DB_PASSWORD=
# Clé de signature des jetons de connexion : 32 caractères aléatoires au
# moins, différente en dev et en prod. Pour en générer une :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=
# Durée d'un jeton de connexion, en minutes (par défaut : 480, une journée)
API_DUREE_JETON_MINUTES=480
# Adresse(s) de l'interface web autorisée(s) à appeler l'API (CORS)
API_CORS_ORIGINS=http://localhost:5173
