# Fins de ligne : Git stocke tout en LF ; chaque poste convertit à l'ouverture.
# Évite les diffs « tout le fichier a changé » entre Windows et le serveur.
* text=auto eol=lf

# Scripts Windows : doivent garder CRLF pour s'exécuter correctement
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Fichiers binaires : jamais convertis
*.png  binary
*.jpg  binary
*.mp3  binary
*.mp4  binary
*.wav  binary
*.pbix binary
